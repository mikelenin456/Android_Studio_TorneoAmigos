<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F4F7F4">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarInicio"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/titulo_inicio"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="#246847"
    android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/descripcion_inicio"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp" />
    <Button
        android:id="@+id/btnEquipo"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/btn_equipo" />
    <Button
        android:id="@+id/btnPartido"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_partido" />
    <Button
        android:id="@+id/btnLista"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_lista" />

    <Button
        android:id="@+id/btnListaPartidos"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_lista_partidos" />
</LinearLayout>